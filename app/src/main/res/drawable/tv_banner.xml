<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#141D29"
                android:centerColor="#0E1622"
                android:endColor="#080C12"
                android:angle="135" />
            <stroke android:width="2dp" android:color="#243140" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/app_logo"
        android:width="96dp"
        android:height="96dp"
        android:gravity="center" />
</layer-list>